# Compose 项目标识
COMPOSE_PROJECT_NAME=buy-sms
APP_IMAGE=buy-sms:local

# 仅应用端口映射到宿主机；PostgreSQL 只在容器内部网络可见。
APP_BIND_ADDR=127.0.0.1
APP_PORT=18080
# 生产环境必须填写可被供应商访问的 HTTPS 地址；本示例仅作为占位，部署前必须替换。
PUBLIC_BASE_URL=https://replace_with_public_domain.example
TZ=Asia/Shanghai

# PostgreSQL 密码会进入连接 URL，请使用 URL 安全字符（推荐十六进制）。
POSTGRES_DB=buy_sms
POSTGRES_USER=buy_sms
POSTGRES_PASSWORD=replace_with_random_hex

# 上线前必须全部替换。JWT_SECRET 建议至少 48 个随机字节。
JWT_SECRET=replace_with_at_least_48_random_bytes
# 32 个随机字节的严格 Base64 编码，可使用 `openssl rand -base64 32` 生成。
DATA_ENCRYPTION_KEY=replace_with_32_random_bytes
ADMIN_ENTRY_PATH=/manage-replace-with-random-hex
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password
# 使用反向代理时填写受信任代理 IP/CIDR，多个值用英文逗号分隔。
TRUSTED_PROXIES=

# 国际网络构建源（通常无需修改）
NODE_IMAGE=node:22-alpine
GO_IMAGE=golang:1.24-alpine
RUNTIME_IMAGE=alpine:3.21
POSTGRES_IMAGE=postgres:17-alpine
NPM_REGISTRY=https://registry.npmjs.org
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
ALPINE_MIRROR=
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=

# 中国大陆构建覆盖项可按企业镜像仓库调整。
CN_NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
CN_GO_IMAGE=docker.m.daocloud.io/library/golang:1.24-alpine
CN_RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.21
CN_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:17-alpine
CN_NPM_REGISTRY=https://registry.npmmirror.com
CN_GOPROXY=https://goproxy.cn,direct
CN_GOSUMDB=sum.golang.google.cn
CN_ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
CN_DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
CN_DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
